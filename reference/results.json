{
  "protocol": {
    "name": "CWRU held-out fault-class benchmark, T2 class partition",
    "data_root": "data/raw/cwru",
    "source_classes": [
      "IR007",
      "IR014",
      "IR021",
      "OR007@6",
      "OR014@6",
